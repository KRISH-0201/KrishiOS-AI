# Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════
# KRISHIOS AI — .env.example
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to Git.
# ═══════════════════════════════════════════════════════════════════════════

# ─── DATABASE CONFIGURATION ────────────────────────────────────────────────
POSTGRES_USER=krishios
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=krishios_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full connection URL (auto-built from above in docker-compose; or set directly)
# DATABASE_URL=postgresql://krishios:CHANGE_ME@db:5432/krishios_db

# ─── BACKEND SECURITY ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_random_64_character_hex_string_here

# JWT token expiry in seconds (86400 = 24 hours)
ACCESS_TOKEN_EXPIRE_SECONDS=86400

# bcrypt cost factor (12 is recommended; higher = slower but more secure)
BCRYPT_ROUNDS=12

# ─── AI SERVICES ───────────────────────────────────────────────────────────
# Get your free API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=CHANGE_ME_your_gemini_api_key_here

# Gemini model to use
GEMINI_MODEL=gemini-1.5-pro

# ─── FILE STORAGE ──────────────────────────────────────────────────────────
# Directory where uploaded images are saved (relative to backend/)
UPLOAD_DIR=uploads

# Maximum upload file size in bytes (10MB = 10485760)
MAX_UPLOAD_SIZE=10485760

# ─── CORS ──────────────────────────────────────────────────────────────────
# URL of the React frontend (used to configure CORS)
FRONTEND_URL=http://localhost:3000

# ─── ML MODEL ──────────────────────────────────────────────────────────────
# Path to the trained TensorFlow model (relative to backend/)
MODEL_PATH=ml/model.h5

# Path to class labels JSON file
CLASS_LABELS_PATH=ml/class_labels.json

# ─── LOGGING ───────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ─── APPLICATION ───────────────────────────────────────────────────────────
APP_NAME=KrishiOS AI
APP_VERSION=1.0.0
DEBUG=false
