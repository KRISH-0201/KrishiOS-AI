plantvillage dataset/
*.zip
*.tar
*.gz

# Secrets, Environment Files & Keys (CRITICAL: Do not expose)
.env
*.env
backend/.env
frontend/.env
frontend/.env.local

# Python Environments & Caches
venv/
backend/venv/
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backend/.pytest_cache/

# Local Databases
*.db
*.sqlite
*.sqlite3
backend/krishios_local.db

# Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
.oxlintcache/

# IDE & OS Artifacts
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
.DS_Store

# Research scripts pointing to removed external datasets
research/

